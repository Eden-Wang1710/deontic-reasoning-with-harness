#!/usr/bin/env python3
"""read_document <docid> "<what to look for>" [from_line]: have the reader read one document again.
(Not called `read`: that is a shell builtin.)"""
import sys
from _bcp import post

if __name__ == "__main__":
    args = sys.argv[1:]
    if len(args) < 2 or not args[0].strip():
        print('Usage: read_document <docid> "<what to look for>" [from_line]'); sys.exit(2)
    from_line = 1
    if len(args) >= 3 and args[-1].strip().isdigit():
        from_line = int(args[-1]); args = args[:-1]
    sys.exit(post("/v01/read", "read_document", docid=args[0].strip(), what=" ".join(args[1:]).strip(), from_line=from_line))
