#!/usr/bin/env python3
"""search "<query>": top documents of the BrowseComp-Plus collection for a query."""
import json, os, sys, urllib.request

def main() -> int:
    query = " ".join(sys.argv[1:]).strip()
    if not query:
        print('Usage: search "<query>"')
        return 2
    addr = os.environ.get("BCP_TOOLS_ADDR", "172.17.0.1:9010")
    body = json.dumps({"query": query, "qid": os.environ.get("BCP_QID", "")}).encode()
    req = urllib.request.Request(f"http://{addr}/search", data=body,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=100) as resp:
            print(json.load(resp)["text"])
    except Exception as exc:  # noqa: BLE001
        print(f"search: the request failed ({exc}). Try again.", file=sys.stderr)
        return 1
    return 0

if __name__ == "__main__":
    sys.exit(main())
