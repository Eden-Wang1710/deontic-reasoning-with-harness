Sending keys: ['python3 << \'EOF\'\n# Alice\'s tax calculation for 2015\n\n# Facts\ngross_income = 395276\nitemized_deductions = 4571 + 1973 + 15271  # = 21815\n\nprint(f"Total itemized deductions: {itemized_deductions}")\n\n# §68 limitation for unmarried individual (threshold = $250,000)\nagi = gross_income  # Assuming gross income = AGI\nthreshold = 250000\nexcess_agi = agi - threshold\nprint(f"AGI excess over threshold: ${excess_agi}")\n\n# §68 reduction = lesser of 3% of excess or 80% of itemized deductions\nreduction_3_percent = excess_agi * 0.03\nreduction_80_percent = itemized_deductions * 0.80\nprint(f"3% of excess: ${reduction_3_percent}")\nprint(f"80% of itemized deductions: ${reduction_80_percent}")\n\nsection_68_reduction = min(reduction_3_percent, reduction_80_percent)\nprint(f"§68 reduction: ${section_68_reduction}")\n\nallowable_itemized = itemized_deductions - section_68_reduction\nprint(f"Allowable itemized deductions: ${allowable_itemized}")\n\n# Personal exemption phaseout (§151(d)(3))\n# Applicable percentage = 2% for each $2,500 (or fraction thereof) over threshold\nfraction = (excess_agi / 2500)\nimport math\nfractions = math.ceil(fraction)\nprint(f"Fractions over threshold: {fractions}")\napplicable_percentage = fractions * 0.02\nprint(f"Applicable percentage: {applicable_percentage * 100}%")\n\nexemption_amount = 2000\nexemption_reduction = exemption_amount * applicable_percentage\nexemption = max(0, exemption_amount - exemption_reduction)\nprint(f"Personal exemption: ${exemption}")\n\n# Taxable income\ntaxable_income = agi - allowable_itemized - exemption\nprint(f"Taxable income: ${taxable_income}")\n\n# Tax calculation for unmarried individual (§1(c))\n# (v) $79,772, plus 39.6% of the excess over $250,000 if taxable income > $250,000\ntax = 79772 + (taxable_income - 250000) * 0.396\nprint(f"Tax: ${tax}")\nprint(f"Tax (rounded): ${round(tax)}")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
