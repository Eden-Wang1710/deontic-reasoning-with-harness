Sending keys: ['python3 << \'EOF\'\nfrom datetime import date\n\n# Employment dates with number of employees\nevents = [\n    (2017, 1, 24, 5),   # Bob, Cameron, Dan, Emily, Fred\n    (2017, 2, 4, 3),    # Bob, Cameron, Fred\n    (2017, 3, 3, 5),    # Bob, Cameron, Dan, Emily, Fred\n    (2017, 3, 18, 5),   # Cameron, Dan, Emily, Fred, George\n    (2017, 4, 1, 5),    # Bob, Cameron, Dan, Fred, George\n    (2017, 5, 9, 5),    # Cameron, Dan, Emily, Fred, George\n    (2017, 10, 14, 5),  # Bob, Cameron, Dan, Emily, George\n    (2017, 10, 25, 4),  # Bob, Emily, Fred, George\n    (2017, 11, 8, 5),   # Bob, Cameron, Emily, Fred, George\n    (2017, 11, 22, 5),  # Bob, Cameron, Dan, Emily, Fred\n    (2017, 12, 1, 5),   # Bob, Cameron, Dan, Emily, George\n    (2017, 12, 2, 5),   # Bob, Cameron, Dan, Emily, George\n]\n\n# Count distinct calendar weeks (Sunday=0 to Saturday=6)\n# Python\'s isocalendar() gives ISO weeks (Monday=first day)\n# We need calendar weeks (Sunday=first day)\n\ndef get_calendar_week(year, month, day):\n    """Get the week number assuming weeks start on Sunday"""\n    d = date(year, month, day)\n    # Get day of week (Monday=0, Sunday=6 in Python)\n    dow = d.weekday()  # 0=Mon, 6=Sun\n    # Convert to Sunday=0, Saturday=6\n    dow_sunday = (dow + 1) % 7\n    # Calculate days since start of year\n    start_of_year = date(year, 1, 1)\n    days_from_start = (d - start_of_year).days\n    # First Sunday of the year\n    first_sunday = date(year, 1, 1)\n    first_sunday = date(year, 1, 1) - timedelta(days=first_sunday.weekday())\n    # Actually let\'s use a simpler approach\n    return d.isocalendar()[1]  # ISO week number\n\nfrom datetime import timedelta\n\n# Get calendar week (Sunday-based)\ndef get_week_number(year, month, day):\n    d = date(year, month, day)\n    # Find the Sunday of this week\n    dow = d.weekday()  # 0=Mon, 6=Sun\n    days_since_sunday = (dow + 1) % 7  # Days since most recent Sunday\n    sunday_of_week = d - timedelta(days=days_since_sunday)\n    # Calculate week number from Jan 1\n    jan1 = date(year, 1, 1)\n    jan1_sunday = jan1 - timedelta(days=jan1.weekday())\n    week_num = (sunday_of_week - jan1_sunday).days // 7 + 1\n    return week_num\n\nweeks_with_5plus = set()\nfor year, month, day, count in events:\n    if count >= 5:\n        week = get_week_number(year, month, day)\n        weeks_with_5plus.add(week)\n        print(f"{year}-{month:02d}-{day:02d}: {count} employees, Week {week}")\n\nprint(f"\\nTotal distinct weeks with 5+ employees: {len(weeks_with_5plus)}")\nprint(f"Weeks: {sorted(weeks_with_5plus)}")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
