Sending keys: ['python3 << \'EOF\'\n# Case Facts\ngross_income_2017 = 567192\ncharity_deduction = 59850\n\n# Step 1: Determine Filing Status for 2017\n# Bob died Oct 22, 2016 - within 2 years before 2017\n# Alice maintains household with Charlie (her son)\n# Charlie is a dependent (qualifying child)\n# Alice qualifies as "surviving spouse" per §2(a)\n\n# Step 2: Calculate AGI\n# Charity deduction is an itemized deduction (not above-the-line)\nagi = gross_income_2017  # No above-the-line deductions mentioned\nprint(f"AGI: ${agi}")\n\n# Step 3: Calculate Exemptions\n# §151(d)(4) - Exemption amount is $2,000\nexemption_amount = 2000\n\n# Personal exemptions:\n# - Taxpayer (Alice): $2,000\n# - Spouse (Bob): $0 (died in 2016)\n# - Dependent (Charlie): $2,000 (qualifies as qualifying child)\ntotal_exemptions = exemption_amount * 2  # Alice + Charlie\nprint(f"Total exemptions before phaseout: ${total_exemptions}")\n\n# Step 4: Check Exemption Phaseout (§151(d)(3))\n# For surviving spouse, applicable amount is $300,000 (§68(b)(1)(A))\napplicable_amount = 300000\nexcess_agi = agi - applicable_amount\nprint(f"AGI excess over threshold: ${excess_agi}")\n\n# Applicable percentage: 2% for each $2,500 (or fraction)\n# §151(d)(3)(B)\nnum_fractions = (excess_agi + 2499) // 2500  # ceiling division\napplicable_pct = num_fractions * 2\nprint(f"Number of $2,500 fractions: {num_fractions}")\nprint(f"Applicable percentage before cap: {applicable_pct}%")\n\n# Cap at 100%\napplicable_pct = min(applicable_pct, 100)\nprint(f"Applicable percentage (capped): {applicable_pct}%")\n\n# Phaseout reduces exemptions\nfinal_exemptions = total_exemptions * (1 - applicable_pct/100)\nprint(f"Final exemptions after phaseout: ${final_exemptions}")\n\n# Step 5: Calculate Taxable Income (§63)\n# Taxable income = Gross income - deductions (itemized) - exemptions\ntaxable_income = agi - charity_deduction - final_exemptions\nprint(f"Taxable income: ${taxable_income}")\n\n# Step 6: Calculate Tax (§1(a)(2) for surviving spouse)\n# Since taxable income > $250,000:\n# Tax = $75,528.50 + 39.6% of excess over $250,000\nbase_tax = 75528.50\nexcess_over_250k = taxable_income - 250000\nadditional_tax = excess_over_250k * 0.396\ntotal_tax = base_tax + additional_tax\nprint(f"\\nTax calculation:")\nprint(f"Base tax: ${base_tax}")\nprint(f"Excess over $250,000: ${excess_over_250k}")\nprint(f"Additional tax (39.6%): ${additional_tax}")\nprint(f"Total tax: ${total_tax}")\nprint(f"Total tax (rounded): ${round(total_tax)}")\nEOF\n'] min_timeout_sec: 0.0 max_timeout_sec: 180.0
