Sending keys: ['python3 << \'EOF\'\nfrom datetime import date\n\n# Dates in 2017 when Alice employed workers\ndates = [\n    (2017, 1, 24),   # Jan 24\n    (2017, 2, 4),    # Feb 4\n    (2017, 3, 3),    # Mar 3\n    (2017, 3, 18),   # Mar 18\n    (2017, 4, 1),    # Apr 1\n    (2017, 5, 9),    # May 9\n    (2017, 10, 14),  # Oct 14\n    (2017, 10, 25),  # Oct 25\n    (2017, 11, 8),   # Nov 8\n    (2017, 11, 22),  # Nov 22\n    (2017, 12, 1),   # Dec 1\n    (2017, 12, 2),   # Dec 2\n]\n\n# Count people on each date\npeople = {\n    (2017, 1, 24): ["Bob", "Cameron", "Dan", "Emily", "Fred"],\n    (2017, 2, 4): ["Bob", "Cameron", "Dan", "Emily", "Fred"],\n    (2017, 3, 3): ["Bob", "Cameron", "Dan", "Emily", "Fred"],\n    (2017, 3, 18): ["Cameron", "Dan", "Emily", "Fred", "George"],\n    (2017, 4, 1): ["Bob", "Cameron", "Dan", "Fred", "George"],\n    (2017, 5, 9): ["Cameron", "Dan", "Emily", "Fred", "George"],\n    (2017, 10, 14): ["Bob", "Cameron", "Dan", "Emily", "George"],\n    (2017, 10, 25): ["Bob", "Cameron", "Dan", "Emily", "Fred", "George"],\n    (2017, 11, 8): ["Bob", "Cameron", "Emily", "Fred", "George"],\n    (2017, 11, 22): ["Bob", "Cameron", "Dan", "Emily", "Fred"],\n    (2017, 12, 1): ["Bob", "Cameron", "Dan", "Emily", "George"],\n    (2017, 12, 2): ["Bob", "Cameron", "Dan", "Emily", "George"],\n}\n\n# Get ISO week number for each date\nweeks = []\nfor d in dates:\n    dt = date(d[0], d[1], d[2])\n    week = dt.isocalendar()[1]\n    weeks.append((d, week, len(people[d])))\n    print(f"{d}: Week {week}, {len(people[d])} people")\n\ndistinct_weeks = set(w[1] for w in weeks)\nprint(f"\\nDistinct weeks: {sorted(distinct_weeks)}")\nprint(f"Number of distinct weeks: {len(distinct_weeks)}")\nprint(f"\\nAll dates had >= 5 people: {all(w[2] >= 5 for w in weeks)}")\nprint(f"Section 3306(a)(2)(B) requires 10 different weeks with >= 5 people")\nprint(f"Result: {len(distinct_weeks)} >= 10? {len(distinct_weeks) >= 10}")\nEOF\n'] min_timeout_sec: 0.0 max_timeout_sec: 180.0
