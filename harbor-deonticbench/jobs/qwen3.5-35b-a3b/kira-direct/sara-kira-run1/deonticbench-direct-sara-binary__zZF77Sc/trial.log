[polling] saved 0.2s (duration=1.0s) cmd='python3 << \'EOF\'\nfrom datetime import date\n\n# Dates when Alice employed at least 5 people in agricultural labor\ndates_with_5_plus = [\n    date(2017, 1, 24),  # 5 people\n    date(2017, 3, 3),   # 5 people\n    date(2017, 3, 18),  # 5 people\n    date(2017, 4, 1),   # 5 people\n    date(2017, 5, 9),   # 5 people\n    date(2017, 10, 14), # 5 people\n    date(2017, 11, 8),  # 5 people\n    date(2017, 11, 22), # 5 people\n    date(2017, 12, 1),  # 5 people\n    date(2017, 12, 2),  # 5 people\n]\n\n# Get calendar week for each date (ISO week)\nweeks = []\nfor d in dates_with_5_plus:\n    iso_cal = d.isocalendar()\n    weeks.append((d, iso_cal[1], iso_cal[2]))  # (date, year, week number)\n    print(f"{d}: Year {iso_cal[1]}, Week {iso_cal[2]} ({d.strftime(\'%A\')})")\n\n# Count distinct weeks\ndistinct_weeks = set((y, w) for _, y, w in weeks)\nprint(f"\\nTotal days with 5+ workers: {len(dates_with_5_plus)}")\nprint(f"Distinct calendar weeks: {len(distinct_weeks)}")\nprint(f"Distinct weeks: {sorted(distinct_weeks)}")\n\n# Check if we have at least 10 days in 10 different weeks\nif len(dates_with_5_plus) >= 10 and len(distinct_weeks) >= 10:\n    print("\\nConclusion: Alice employed at least 5 individuals on 10 different calendar weeks.")\n    print("Section 3306(a)(2)(B) APPLIES to Alice for 2017.")\nelse:\n    print("\\nConclusion: Section 3306(a)(2)(B) does NOT apply.")\nEOF\n'
