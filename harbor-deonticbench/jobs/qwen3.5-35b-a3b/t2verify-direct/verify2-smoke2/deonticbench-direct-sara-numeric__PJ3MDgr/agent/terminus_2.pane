[?2004l[?2004h> print(f"Increments: {increments}")
[?2004l[?2004h> 
[?2004l[?2004h> applicable_percentage = increments * 2  # 2% per increment
[?2004l[?2004h> print(f"Applicable percentage: {applicable_percentage}%")
[?2004l[?2004h> 
[?2004l[?2004h> # Cap at 100%
[?2004l[?2004h> applicable_percentage = min(applicable_percentage, 100)
