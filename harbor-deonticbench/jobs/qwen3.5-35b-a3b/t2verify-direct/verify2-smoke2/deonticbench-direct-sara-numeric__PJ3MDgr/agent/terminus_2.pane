[?2004l[?2004h> print(f"Total exemptions: {total_exemptions}")
[?2004l[?2004h> print(f"Taxable income: {taxable_income}")
[?2004l[?2004h> 
[?2004l[?2004h> # Tax calculation for unmarried (line 29-37, section (c))
