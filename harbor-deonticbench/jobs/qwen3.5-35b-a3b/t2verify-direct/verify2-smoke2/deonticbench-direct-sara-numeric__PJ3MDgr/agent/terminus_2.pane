[?2004l[?2004h> 
[?2004l[?2004h> # Reduced exemption amount
[?2004l[?2004h> reduced_exemption = exemption_amount * (1 - applicable_percentage/100)
[?2004l[?2004h> print(f"Reduced exemption per person: {reduced_exemption}")
[?2004l[?2004h> 
[?2004l[?2004h> # Alice can claim Bob as dependent (section 152(d)(2)(C) - father)
