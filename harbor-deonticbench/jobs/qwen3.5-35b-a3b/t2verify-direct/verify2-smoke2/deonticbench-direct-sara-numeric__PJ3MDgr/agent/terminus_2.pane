[?2004l[?2004h> total_exemptions = num_exemptions * reduced_exemption
[?2004l[?2004h> 
[?2004l[?2004h> # Taxable income = Gross income - Standard deduction - Personal exemptions
[?2004l[?2004h> taxable_income = alice_gross_income - standard_deduction - total_exemptions
