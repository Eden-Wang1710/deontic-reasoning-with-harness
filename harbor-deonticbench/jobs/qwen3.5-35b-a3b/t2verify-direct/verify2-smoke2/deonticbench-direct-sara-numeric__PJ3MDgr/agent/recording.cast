[958.672061, "o", "6):\r\n   - For taxable income over "]
[958.672076, "o", "\u001b[?2004h> "]
[958.672177, "o", "§151(d)(1) Exemption amount (lines 72-75):\r\n\u001b[?2004l\r"]
[958.672189, "o", "\u001b[?2004h"]
[958.672199, "o", "> "]
[958.672395, "o", "\"Except as otherwise provided in this subsection, the term 'exemption amount' means $2,000.\"\r\n\u001b[?2004l\r"]
