Sending keys: ['python3 << \'EOF\'\n# Case facts\ngross_income = 311510\n\n# Standard deduction for unmarried (any other case)\nstandard_deduction = 3000\n\n# Personal exemption amount\nexemption_amount_base = 2000\n\n# Phaseout calculation\n# AGI exceeds $250,000 (for unmarried under §68(b)(1)(C))\napplicable_amount = 250000\nagi = gross_income  # Assuming no adjustments to get from gross to AGI\nexcess = agi - applicable_amount\n\n# Number of $2,500 increments (or fraction thereof)\nimport math\nnum_increments = math.ceil(excess / 2500)\nprint(f"Excess AGI: ${excess}")\nprint(f"Increments: {num_increments}")\n\n# Applicable percentage = 2% per increment\ncap = min(100, 2 * num_increments)\nprint(f"Phaseout percentage: {cap}%")\n\n# Reduced exemption amount\nexemption = exemption_amount_base * (1 - cap/100)\nprint(f"Exemption after phaseout: ${exemption}")\n\n# Taxable income\ntotal_deductions = standard_deduction + exemption\ntaxable_income = gross_income - total_deductions\nprint(f"Total deductions: ${total_deductions}")\nprint(f"Taxable income: ${taxable_income}")\n\n# Tax calculation under §1(c) for unmarried\n# (v) $79,772, plus 39.6% of the excess over $250,000 if over $250,000\ntax = 79772 + 0.396 * (taxable_income - 250000)\nprint(f"Tax: ${tax}")\nprint(f"Rounded: ${round(tax)}")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
