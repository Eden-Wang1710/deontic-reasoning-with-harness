[1362.976095, "o", "Worker occurrences: {'Bob': 10, 'Cameron': 11, 'Dan': 9, 'Emily': 10, 'Fred': 9, 'George': 8}\r\nBob: 10 occasions x $632 = $6320, taxable = $0\r\nCameron: 11 occasions x $632 = $6952, taxable = $0\r\nDan: 9 occasions x $632 = $5688, taxable = $0\r\nEmily: 10 occasions x $632 = $6320, taxable = $0\r\nFred: 9 occasions x $632 = $5688, taxable = $0\r\nGeorge: 8 occasions x $632 = $5056, taxable = $0\r\nTotal wages: $36024\r\nTaxable wages (after $7000 exclusion): $0\r\n"]
[1362.976131, "o", "Employment tax (6%): $0.0\r\n"]
[1362.976176, "o", "Income tax: $245270.73\r\nTotal tax: $245270.73\r\nRounded total tax: 245271\r\n"]
[1362.978964, "o", "\u001b[?2004h"]
[1362.978999, "o", "root@9aaaffa9e76f:/app# "]
[1488.248814, "i", "python3 -c \"\n# Corrected employment tax calculation\nwage_per_occasion = 632\nworker_counts = {'Bob': 10, 'Cameron': 11, 'Dan': 9, 'Emily': 10, 'Fred': 9, 'George': 8}\n\n# Calculate total wages\ntotal_wages = sum(count * wage_per_occasion for count in worker_counts.values())\nprint(f'Total wages: {total_wages}')\n\n# Per §3306(b)(1), wages exclude only remuneration AFTER \\$7000 is paid\n# Since no worker earned more than \\$7000, all wages are taxable\ntaxable_wages = total_wages\nprint(f'Taxable wages: {taxable_wages}')\n\n# 6% employment tax per §3301\nemployment_tax = taxable_wages * 0.06\nprint(f'Employment tax (6%): {employment_tax}')\n\n# Total tax\nincome_tax = 245270.73\ntotal_tax = income_tax + employment_tax\nprint(f'Total tax: {total_tax}')\nprint(f'Rounded: {round(total_tax)}')\n\"\n"]
[1488.24931, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> # Corrected employment tax calculation\r\n\u001b[?2004l\r\u001b[?2004h> wage_per_occasion = 632\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1488.249565, "o", "worker_counts = {'Bob': 10, 'Cameron': 11, 'Dan': 9, 'Emily': 10, 'Fred': 9, 'George': 8}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Calculate total wages\r\n\u001b[?2004l\r\u001b[?2004h> total_wages = sum(count * wage_per_occasion for count in worker_counts.values())\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Total wages: {total_wages}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
