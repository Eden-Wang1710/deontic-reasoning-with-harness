[1677.096659, "o", "a tax determined in accordance with the following:\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1677.096756, "o", "    (i) 15% of taxable income if the taxable income is not over $36,900;\r\n\u001b[?2004l\r"]
[1677.096884, "o", "\u001b[?2004h> "]
[1677.096923, "o", "    (ii) $5,535, plus 28% of the excess over $36,900 if the taxable income is over $36,900 but not over $89,150;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1677.096936, "o", "> "]
[1677.097135, "o", "    (iii) $20,165, plus 31% of the excess over $89,150 if the taxable income is over $89,150 but not over $140,000;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1677.097235, "o", "    (iv) $35,928.50, plus 36% of the excess over $140,000 if the taxable income is over $140,000 but not over $250,000;\r\n\u001b[?2004l\r\u001b[?2004h"]
