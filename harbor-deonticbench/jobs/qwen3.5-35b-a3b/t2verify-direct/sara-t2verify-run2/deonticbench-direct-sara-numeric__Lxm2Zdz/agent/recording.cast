[414.223067, "i", "python3 -c \"\n# Facts\ngross_income = 684642\n\n# Standard deduction for joint return (200% of 3000)\nstandard_deduction = 2 * 3000\n\n# Exemption phaseout\nagi = gross_income\napplicable_amount = 300000\nexcess = agi - applicable_amount\nfractions = (excess + 2499.99) // 2500  # ceiling division\nphaseout_pct = min(100, fractions * 2)\nprint(f'Excess AGI: {excess}')\nprint(f'Fractions: {fractions}')\nprint(f'Phaseout %: {phaseout_pct}')\n\n# Exemption amount (2 per person = 4000, but 100% phaseout)\nexemption_amount = 0\n\n# Taxable income\ntaxable_income = gross_income - standard_deduction - exemption_amount\nprint(f'Taxable income: {taxable_income}')\n\n# Tax calculation (married filing jointly, over 250000)\nbase_tax = 75528.50\nbracket_excess = taxable_income - 250000\ntax = base_tax + 0.396 * bracket_excess\nprint(f'Tax: {tax}')\nprint(f'Rounded: {round(tax)}')\n\"\n"]
