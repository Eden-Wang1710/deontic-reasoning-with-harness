[1488.250131, "o", "\u001b[?2004h> income_tax = 245270.73\r\n\u001b[?2004l\r\u001b[?2004h> total_tax = income_tax + employment_tax\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Total tax: {total_tax}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Rounded: {round(total_tax)}')\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
