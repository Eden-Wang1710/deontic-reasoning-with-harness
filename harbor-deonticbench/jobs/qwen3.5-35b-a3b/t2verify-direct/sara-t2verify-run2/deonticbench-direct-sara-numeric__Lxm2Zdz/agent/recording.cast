[1362.963106, "o", "# Check if Alice is an employer under §3306(a)(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1362.96313, "o", "print(f'Is Alice an agricultural labor employer? {days_with_5_plus >= 10}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1362.963174, "o", "\u001b[?2004h> # Count total worker occurrences\r\n\u001b[?2004l\r"]
[1362.963197, "o", "\u001b[?2004h> "]
[1362.963214, "o", "worker_counts = Counter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1362.963241, "o", "for workers in payments:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1362.963267, "o", "    for w in workers:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1362.963289, "o", "> "]
[1362.963307, "o", "        worker_counts[w] += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1362.963322, "o", "\u001b[?2004h> "]
[1362.963391, "o", "print(f'Worker occurrences: {dict(worker_counts)}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1362.963426, "o", "# Calculate total wages and taxable wages\r\n\u001b[?2004l\r\u001b[?2004h"]
[1362.963452, "o", "> "]
[1362.963495, "o", "# Per §3306(b)(1): wages exclude remuneration after \\$7000 paid to an individual\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1362.963512, "o", "total_wages = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[1362.96352, "o", "> "]
[1362.96354, "o", "taxable_wages = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[1362.963548, "o", "> "]
[1362.963588, "o", "for worker, count in worker_counts.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[1362.963594, "o", "> "]
[1362.963683, "o", "    worker_total = count * wage_per_occasion\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1362.963732, "o", "    total_wages += worker_total\r\n\u001b[?2004l\r\u001b[?2004h>     # Apply \\$7000 exclusion\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1362.963766, "o", "    taxable = max(0, worker_total - 7000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1362.963777, "o", "    taxable_wages += taxable\r\n\u001b[?2004l\r"]
[1362.963808, "o", "\u001b[?2004h> "]
[1362.963872, "o", "    print(f'{worker}: {count} occasions x \\${wage_per_occasion} = \\${worker_total}, taxable = \\${taxable}')\r\n\u001b[?2004l\r"]
[1362.963882, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1362.963889, "o", "\u001b[?2004h> "]
[1362.96393, "o", "print(f'Total wages: \\${total_wages}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1362.963936, "o", "> "]
[1362.96408, "o", "print(f'Taxable wages (after \\$7000 exclusion): \\${taxable_wages}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 6% employment tax per §3301\r\n\u001b[?2004l\r\u001b[?2004h> employment_tax = taxable_wages * 0.06\r\n\u001b[?2004l\r"]
[1362.964094, "o", "\u001b[?2004h> "]
[1362.964201, "o", "print(f'Employment tax (6%): \\${employment_tax}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Income tax from before\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1362.964232, "o", "income_tax = 245270.73\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1362.964258, "o", "total_tax = income_tax + employment_tax\r\n\u001b[?2004l\r\u001b[?2004h"]
[1362.964287, "o", "> print(f'Income tax: \\${income_tax}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1362.964325, "o", "print(f'Total tax: \\${total_tax}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1362.964353, "o", "> "]
[1362.964381, "o", "print(f'Rounded total tax: {round(total_tax)}')\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
