[1677.097427, "o", "    (v) $75,528.50, plus 39.6% of the excess over $250,000 if the taxable income is over $250,000.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
