[1362.961424, "i", "python3 -c \"\nfrom collections import Counter\n\n# Payment schedule (date: workers)\npayments = [\n    ['Bob', 'Cameron', 'Dan', 'Emily', 'Fred'],      # Jan 24 - 5 workers\n    ['Bob', 'Cameron', 'Fred'],                       # Feb 4 - 3 workers\n    ['Bob', 'Cameron', 'Dan', 'Emily', 'Fred'],      # Mar 3 - 5 workers\n    ['Cameron', 'Dan', 'Emily', 'Fred', 'George'],   # Mar 19 - 5 workers\n    ['Bob', 'Cameron', 'Dan', 'Fred', 'George'],     # Apr 2 - 5 workers\n    ['Cameron', 'Dan', 'Emily', 'Fred', 'George'],   # May 9 - 5 workers\n    ['Bob', 'Cameron', 'Dan', 'Emily', 'George'],    # Oct 15 - 5 workers\n    ['Bob', 'Emily', 'Fred', 'George'],              # Oct 25 - 4 workers\n    ['Bob', 'Cameron', 'Emily', 'Fred', 'George'],   # Nov 8 - 5 workers\n    ['Bob', 'Cameron', 'Dan', 'Emily', 'Fred'],      # Nov 22 - 5 workers\n    ['Bob', 'Cameron', 'Dan', 'Emily', 'George'],    # Dec 1 - 5 workers\n    ['Bob', 'Cameron', 'Dan', 'Emily', 'George'],    # Dec 3 - 5 workers\n]\n\nwage_per_occasion = 632\n\n# Count days with 5+"]
[1362.961497, "i", " workers (for §3306(a)(2)(B) threshold)\ndays_with_5_plus = sum(1 for workers in payments if len(workers) >= 5)\nprint(f'Days with 5+ workers: {days_with_5_plus}')\n\n# Check if Alice is an employer under §3306(a)(2)\nprint(f'Is Alice an agricultural labor employer? {days_with_5_plus >= 10}')\n\n# Count total worker occurrences\nworker_counts = Counter()\nfor workers in payments:\n    for w in workers:\n        worker_counts[w] += 1\n\nprint(f'Worker occurrences: {dict(worker_counts)}')\n\n# Calculate total wages and taxable wages\n# Per §3306(b)(1): wages exclude remuneration after \\$7000 paid to an individual\ntotal_wages = 0\ntaxable_wages = 0\nfor worker, count in worker_counts.items():\n    worker_total = count * wage_per_occasion\n    total_wages += worker_total\n    # Apply \\$7000 exclusion\n    taxable = max(0, worker_total - 7000)\n    taxable_wages += taxable\n    print(f'{worker}: {count} occasions x \\${wage_per_occasion} = \\${worker_total}, taxable = \\${taxable}')\n\nprint(f'Total wages: \\${total_wages}')\nprint(f'Taxable"]
[1362.961508, "i", " wages (after \\$7000 exclusion): \\${taxable_wages}')\n\n# 6% employment tax per §3301\nemployment_tax = taxable_wages * 0.06\nprint(f'Employment tax (6%): \\${employment_tax}')\n\n# Income tax from before\nincome_tax = 245270.73\ntotal_tax = income_tax + employment_tax\nprint(f'Income tax: \\${income_tax}')\nprint(f'Total tax: \\${total_tax}')\nprint(f'Rounded total tax: {round(total_tax)}')\n\"\n"]
