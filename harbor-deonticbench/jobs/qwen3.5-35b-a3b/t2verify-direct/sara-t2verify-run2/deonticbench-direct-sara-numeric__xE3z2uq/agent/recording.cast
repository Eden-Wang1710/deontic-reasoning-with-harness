[1200.576979, "i", "python3 << 'EOF'\n# Case Facts\nalice_income = 133200\nbob_income = 44311\n\n# Combined gross income\ngross_income = alice_income + bob_income\nprint(f\"Combined gross income: ${gross_income}\")\n\n# Standard deduction: $3,000 × 200% = $6,000 for joint + $600 for blind\nbasic_std = 3000 * 2  # 200% of $3,000\nblind_add = 600\nstandard_deduction = basic_std + blind_add\nprint(f\"Standard deduction: ${standard_deduction} (${basic_std} basic + ${blind_add} blind)\")\n\n# Personal exemptions: $2,000 each for Alice and Bob\n# Charlie is NOT a dependent (has income from work)\nexemption_amount = 2000  # 2017 exemption amount\nnum_exemptions = 2  # Alice and Bob only\npersonal_exemptions = exemption_amount * num_exemptions\nprint(f\"Personal exemptions: ${personal_exemptions} (${exemption_amount} × 2)\")\n\n# Taxable income = AGI - standard deduction - personal exemptions\ntaxable_income = gross_income - standard_deduction - personal_exemptions\nprint(f\"Taxable income: ${taxable_income}\")\n\n# Tax calculation for MFJ (Section 1(a))\n# (iii) $20,1"]
[1200.577301, "i", "65, plus 31% of the excess over $89,150 if taxable income is over $89,150 but not over $140,000\nif taxable_income <= 36900:\n    tax = taxable_income * 0.15\nelif taxable_income <= 89150:\n    tax = 5535 + 0.28 * (taxable_income - 36900)\nelif taxable_income <= 140000:\n    tax = 20165 + 0.31 * (taxable_income - 89150)\nelif taxable_income <= 250000:\n    tax = 35928.50 + 0.36 * (taxable_income - 140000)\nelse:\n    tax = 75528.50 + 0.396 * (taxable_income - 250000)\n\nprint(f\"Tax calculated: ${tax}\")\nprint(f\"Tax (rounded): ${round(tax)}\")\nEOF\n"]
[1200.577331, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r65, plus 31% of the excess over $89,150 if taxable income is over $89,150 but not over $140,000\r\nif taxable_income <= 36900:\r\n    tax = taxable_income * 0.15\r\nelif taxable_income <= 89150:\r\n    tax = 5535 + 0.28 * (ta"]
[1200.5775, "o", "xable_income - 36900)\r\nelif taxable_income <= 140000:\r\n    tax = 20165 + 0.31 * (taxable_income - 89150)\r\nelif taxable_income <= 250000:\r\n    tax = 35928.50 + 0.36 * (taxable_income - 140000)\r\nelse:\r\n    tax = 75528.50 + 0.396 * (taxable_income - 250000)\r\n\r\nprint(f\"Tax calculated: ${tax}\")\r\nprint(f\"Tax (rounded): ${round(tax)}\")\r\nEOF\r\n\u001b[?2004h> "]
