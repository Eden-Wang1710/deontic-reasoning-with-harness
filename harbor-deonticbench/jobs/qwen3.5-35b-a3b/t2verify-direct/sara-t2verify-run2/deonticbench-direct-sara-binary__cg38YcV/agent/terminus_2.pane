# Get unique calendar weeks (Monday-Sunday)
# ISO week is Monday-Sunday
def get_calendar_week(d):
    iso = d.isocalendar()
    return (iso[0], iso[1])  # (year, week_number)

weeks_with_5plus = set(get_calendar_week(d) for d, _ in five_or_more)
print(f"\nUnique calendar weeks with 5+ workers: {len(weeks_with_5plus)}")
for w in sorted(weeks_with_5plus):
    print(f"  Week {w}")

# Check if condition is met
condition_met = len(weeks_with_5plus) >= 10
