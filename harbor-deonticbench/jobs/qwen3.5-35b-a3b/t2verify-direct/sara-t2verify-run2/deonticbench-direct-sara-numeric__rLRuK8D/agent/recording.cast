[936.004503, "o", "\u001b[?2004h> "]
[936.004577, "o", "§151(c)(7) Special rules for taxable years 2018 through 2025\r\n\u001b[?2004l\r"]
[936.004599, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[936.004622, "o", "\u001b[?2004h> "]
