[936.003387, "o", "> "]
[936.003601, "o", "        (D) who is not a qualifying child of such taxpayer or of any other taxpayer for any taxable year beginning in the calendar year in which such taxable year begins.\r\n\u001b[?2004l\r"]
[936.003632, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[936.003661, "o", "    (2) Relationship\r\n\u001b[?2004l\r"]
