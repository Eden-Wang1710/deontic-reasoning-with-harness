[936.005025, "o", "\u001b[?2004h> "]
[936.005109, "o", "        (i) by substituting \"$18,000\" for \"$4,400\" in subparagraph (B), and\r\n\u001b[?2004l\r"]
[936.00513, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[936.005151, "o", "\u001b[?2004h> "]
