[936.004266, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[936.004379, "o", "        (B) $4,400 in the case of a head of household (as defined in section 2(b)), or\r\n\u001b[?2004l\r"]
[936.004401, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[936.004418, "o", "\u001b[?2004h> "]
[936.004461, "o", "        (C) $3,000 in any other case.\r\n\u001b[?2004l\r"]
