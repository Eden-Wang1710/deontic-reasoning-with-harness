[936.00895, "o", "\u001b[?2004h> "]
[936.008971, "o", "## Answer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[936.008993, "o", "Answer: 1877\r\n\u001b[?2004l\r"]
