[936.004659, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[936.004738, "o", "    (7) Special rules for taxable years 2018 through 2025\r\n\u001b[?2004l\r"]
[936.00476, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[936.004781, "o", "> "]
[936.004896, "o", "    In the case of a taxable year beginning after December 31, 2017, and before January 1, 2026-\r\n\u001b[?2004l\r"]
[936.004919, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[936.004946, "o", "\u001b[?2004h> "]
