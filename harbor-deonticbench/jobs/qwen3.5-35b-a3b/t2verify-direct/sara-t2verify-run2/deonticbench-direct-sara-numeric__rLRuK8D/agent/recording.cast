[936.003746, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[936.003993, "o", "    For purposes of paragraph (1)(A), an individual bears a relationship to the taxpayer described in this paragraph if the individual is any of the following with respect to the taxpayer:\r\n\u001b[?2004l\r"]
[936.00404, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[936.004117, "o", "        (E) A son or daughter of a brother or sister of the taxpayer.\r\n\u001b[?2004l\r"]
[936.00414, "o", "\u001b[?2004h"]
[936.004159, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
