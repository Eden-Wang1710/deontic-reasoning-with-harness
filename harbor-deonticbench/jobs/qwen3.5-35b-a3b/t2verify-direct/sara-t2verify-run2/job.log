Sending keys: ['python3 << \'EOF\'\nfrom datetime import date\n\n# Employment dates in 2017 with employees\nemployment_dates = [\n    (2017, 1, 24, ["Bob", "Cameron", "Dan", "Emily", "Fred"]),\n    (2017, 2, 4, ["Bob", "Cameron", "Dan", "Emily", "Fred"]),\n    (2017, 3, 3, ["Bob", "Cameron", "Dan", "Emily", "Fred"]),\n    (2017, 3, 18, ["Cameron", "Dan", "Emily", "Fred", "George"]),\n    (2017, 4, 1, ["Bob", "Cameron", "Dan", "Fred", "George"]),\n    (2017, 5, 9, ["Cameron", "Dan", "Emily", "Fred", "George"]),\n    (2017, 10, 14, ["Bob", "Cameron", "Dan", "Emily", "George"]),\n    (2017, 10, 25, ["Bob", "Cameron", "Dan", "Emily", "Fred", "George"]),\n    (2017, 11, 8, ["Bob", "Cameron", "Emily", "Fred", "George"]),\n    (2017, 11, 22, ["Bob", "Cameron", "Dan", "Emily", "Fred"]),\n    (2017, 12, 1, ["Bob", "Cameron", "Dan", "Emily", "George"]),\n    (2017, 12, 2, ["Bob", "Cameron", "Dan", "Emily", "George"]),\n]\n\n# Get calendar week number (ISO week)\ncalendar_weeks = set()\nfor year, month, day, employees in employment_dates:\n    d = date(year, month, day)\n    iso_cal = d.isocalendar()\n    week_key = (iso_cal[0], iso_cal[1])  # (year, week)\n    calendar_weeks.add(week_key)\n    print(f"{month}/{day}: weekday={d.strftime(\'%A\')}, ISO week={week_key}, employees={len(employees)}")\n\nprint(f"\\nTotal unique calendar weeks: {len(calendar_weeks)}")\nprint(f"Calendar weeks: {sorted(calendar_weeks)}")\n\n# Check condition: at least 10 days in different calendar weeks with at least 5 employees\ncondition_met = len(calendar_weeks) >= 10\nprint(f"\\nCondition met (>=10 different calendar weeks): {condition_met}")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
