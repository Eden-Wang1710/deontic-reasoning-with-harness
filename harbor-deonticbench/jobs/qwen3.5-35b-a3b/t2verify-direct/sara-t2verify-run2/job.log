Sending keys: ['python3 << \'EOF\'\n# Alice\'s gross income\nAGI = 264215\n\n# Standard deduction for unmarried individual (§63(c)(2)(C))\nstandard_deduction = 3000\n\n# Personal exemptions before phaseout\nexemption_amount = 2000  # per person\n# Alice: 1 exemption, Bob (father, no income, qualifies as qualifying relative per §152(d)): 1 exemption\ntotal_exemptions = exemption_amount * 2  # $4,000\n\n# Exemption phaseout (§151(d)(3) and §68(b)(1)(C))\napplicable_amount = 250000  # for unmarried individual (§68(b)(1)(C))\nexcess_agi = AGI - applicable_amount  # $14,215\n\n# Applicable percentage: 2 percentage points for each $2,500 (or fraction thereof)\nimport math\nfractions = math.ceil(excess_agi / 2500)  # ceil(14215/2500) = ceil(5.686) = 6\napplicable_percentage = fractions * 2  # 6 * 2 = 12%\n\nprint(f"Excess AGI: ${excess_agi}")\nprint(f"Fractions of $2,500: {fractions}")\nprint(f"Applicable percentage: {applicable_percentage}%")\n\n# Reduced exemptions\nreduced_exemptions = total_exemptions * (1 - applicable_percentage / 100)\nprint(f"Total exemptions: ${total_exemptions}")\nprint(f"Reduced exemptions: ${reduced_exemptions}")\n\n# Taxable income (§63(b))\ntaxable_income = AGI - standard_deduction - reduced_exemptions\nprint(f"Taxable income: ${taxable_income}")\n\n# Tax calculation (§1(c)(v)): For income over $250,000\n# $79,772 + 39.6% of excess over $250,000\ntax = 79772 + 0.396 * (taxable_income - 250000)\nprint(f"Tax: ${tax}")\nprint(f"Tax (rounded): ${round(tax)}")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
