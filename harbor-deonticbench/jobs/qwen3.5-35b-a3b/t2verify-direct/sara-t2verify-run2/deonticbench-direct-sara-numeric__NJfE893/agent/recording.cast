[1417.747217, "o", "python3 -c \"agi=304598; std_ded=18000; taxable=agi-std_ded; tax=77485+0.396*(taxable-250000); print(f'Taxable income: {taxable}'); print(f'Tax: {tax}'); print(f'Rounded: {round(tax)}')\"\r\n\u001b[?2004l\r"]
