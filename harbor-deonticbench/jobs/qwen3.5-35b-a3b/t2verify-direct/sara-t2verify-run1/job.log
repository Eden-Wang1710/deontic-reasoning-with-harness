Sending keys: ['python3 << \'EOF\'\n# Alice\'s Tax Calculation for 2016\n\n# Facts\ngross_income = 567192  # Alice\'s gross income\nitemized_deductions = 100206  # Alice\'s itemized deductions\n\n# Filing Status: Married Filing Separately\n# (married on Jan 12, 2016, doesn\'t file joint return)\n\n# Personal Exemptions:\n# - Alice herself: $2,000\n# - Spouse (no income, not dependent of another): $2,000\n# - Bob (lives with parents, Alice doesn\'t provide >50% support): $0\npersonal_exemptions = 2000 + 2000  # $4,000\n\n# AGI = Gross Income (no adjustments mentioned)\nagi = gross_income  # $567,192\n\n# Phaseout of Exemptions (§151(d)(3))\n# For married filing separately, applicable amount = $150,000 (§68(b)(1)(D))\napplicable_amount = 150000\nexcess_agi = agi - applicable_amount  # $417,192\n\n# Number of $2,500 increments (or fraction thereof)\nincrements = (excess_agi / 2500)\nimport math\nfull_increments = math.ceil(increments)  # 167\napplicable_percentage = full_increments * 0.02  # 334%\n\n# Since applicable_percentage > 100%, exemptions are completely phased out\nif applicable_percentage >= 1.0:\n    exemptions_deduction = 0\nelse:\n    exemptions_deduction = personal_exemptions * (1 - applicable_percentage)\n\nprint(f"AGI: ${agi}")\nprint(f"Excess over threshold: ${excess_agi}")\nprint(f"Increments: {full_increments} ({applicable_percentage*100}%)")\nprint(f"Personal exemptions deduction: ${exemptions_deduction}")\n\n# Itemized Deduction Limitation (§68)\n# Reduction is lesser of: 3% of excess OR 80% of itemized deductions\nlimitation_3_percent = excess_agi * 0.03  # $12,515.76\nlimitation_80_percent = itemized_deductions * 0.80  # $80,164.80\nitemized_limitation = min(limitation_3_percent, limitation_80_percent)\nallowable_itemized = itemized_deductions - itemized_limitation\n\nprint(f"\\nItemized deduction limitation: ${itemized_limitation}")\nprint(f"Allowable itemized deductions: ${allowable_itemized}")\n\n# Taxable Income\ntaxable_income = agi - allowable_itemized  # No personal exemptions deduction\nprint(f"\\nTaxable Income: ${taxable_income}")\n\n# Tax Calculation for Married Filing Separately (§1(d))\n# Taxable income over $125,000 but not over $250,000: $17,964.25 + 36% of excess over $70,000\n# Taxable income over $250,000: $37,764.25 + 39.6% of excess over $125,000\n\nif taxable_income <= 125000:\n    tax = 17964.25 + 0.36 * (taxable_income - 70000) if taxable_income > 70000 else 17964.25\nelif taxable_income <= 250000:\n    tax = 17964.25 + 0.36 * (taxable_income - 70000)\nelse:\n    tax = 37764.25 + 0.396 * (taxable_income - 125000)\n\nprint(f"\\nTax Calculation:")\nprint(f"  Base tax: $37,764.25")\nprint(f"  Excess over $125,000: ${taxable_income - 125000}")\nprint(f"  Additional tax: ${0.396 * (taxable_income - 125000)}")\nprint(f"  Total tax: ${tax}")\nprint(f"  Rounded: ${round(tax)}")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
