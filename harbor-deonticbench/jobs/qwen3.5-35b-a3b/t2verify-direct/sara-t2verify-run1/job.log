s_income - standard_deduction - exemptions\nprint(f"\\nGross income: ${gross_income}")\nprint(f"Standard deduction: ${standard_deduction}")\nprint(f"Exemptions: ${exemptions}")\nprint(f"Taxable income: ${taxable_income}")\n\n# Tax brackets for married filing jointly\nif taxable_income <= 36900:\n    income_tax = taxable_income * 0.15\nelif taxable_income <= 89150:\n    income_tax = 5535 + (taxable_income - 36900) * 0.28\nelif taxable_income <= 140000:\n    income_tax = 20165 + (taxable_income - 89150) * 0.31\nelif taxable_income <= 250000:\n    income_tax = 35928.50 + (taxable_income - 140000) * 0.36\nelse:\n    income_tax = 75528.50 + (taxable_income - 250000) * 0.396\n\nprint(f"Income tax: ${income_tax}")\n\n# Total tax\ntotal_tax = income_tax + employment_tax\nprint(f"\\nTotal tax: ${total_tax}")\nprint(f"Rounded: ${round(total_tax)}")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
