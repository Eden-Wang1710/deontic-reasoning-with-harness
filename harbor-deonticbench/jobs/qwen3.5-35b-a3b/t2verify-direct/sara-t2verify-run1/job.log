Sending keys: ['cat > /tmp/analyze.py << \'EOF\'\nfrom datetime import date, timedelta\n\n# Employment data for 2017\nevents = [\n    (date(2017, 1, 24), ["Bob", "Cameron", "Dan", "Emily", "Fred"]),\n    (date(2017, 2, 4), ["Bob", "Cameron", "Fred"]),\n    (date(2017, 3, 3), ["Bob", "Cameron", "Dan", "Emily", "Fred"]),\n    (date(2017, 3, 18), ["Cameron", "Dan", "Emily", "Fred", "George"]),\n    (date(2017, 4, 1), ["Bob", "Cameron", "Dan", "Fred", "George"]),\n    (date(2017, 5, 9), ["Cameron", "Dan", "Emily", "Fred", "George"]),\n    (date(2017, 10, 14), ["Bob", "Cameron", "Dan", "Emily", "George"]),\n    (date(2017, 10, 25), ["Bob", "Emily", "Fred", "George"]),\n    (date(2017, 11, 8), ["Bob", "Cameron", "Emily", "Fred", "George"]),\n    (date(2017, 11, 22), ["Bob", "Cameron", "Dan", "Emily", "Fred"]),\n    (date(2017, 12, 1), ["Bob", "Cameron", "Dan", "Emily", "George"]),\n    (date(2017, 12, 2), ["Bob", "Cameron", "Dan", "Emily", "George"]),\n]\n\n# Calculate ISO week number for each date\nprint("Analyzing employment days:")\nprint("="*60)\n\nqualifying_days = []\nfor d, workers in events:\n    num_workers = len(workers)\n    iso_year, iso_week, iso_day = d.isocalendar()\n    week_key = (iso_year, iso_week)\n    print(f"{d}: {num_workers} workers - Week {iso_week} of {iso_year}")\n    if num_workers >= 5:\n        qualifying_days.append((d, num_workers, week_key))\n\nprint("\\nDays with 5+ workers:")\nprint("="*60)\n\n# Get unique weeks for qualifying days\nunique_weeks = set()\nfor d, num_workers, week_key in qualifying_days:\n    print(f"{d}: {num_workers} workers, week {week_key}")\n    unique_weeks.add(week_key)\n\nprint(f"\\nNumber of unique weeks with 5+ workers: {len(unique_weeks)}")\nprint(f"Qualifies for 3306(a)(2)(B): {len(unique_weeks) >= 10}")\nEOF\npython3 /tmp/analyze.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
