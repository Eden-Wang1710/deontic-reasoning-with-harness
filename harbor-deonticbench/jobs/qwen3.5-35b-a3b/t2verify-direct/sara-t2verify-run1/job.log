Sending keys: ['python3 << \'EOF\'\n# Alice\'s tax calculation for 2015\n\n# Facts\ngross_income = 395276\nitemized_deductions = 4571 + 1973 + 15271  # $21,815\n\n# Filing status: Unmarried individual (Alice is referred to as a single person)\n# Applicable amount for unmarried: $250,000 (section 68(b)(1)(C))\napplicable_amount = 250000\n\n# Pease limitation (section 68)\n# Reduction = lesser of:\n# (1) 3% of excess AGI over applicable amount\n# (2) 80% of itemized deductions\n\nexcess_agi = gross_income - applicable_amount  # 145276\nreduction1 = excess_agi * 0.03  # 4358.28\nreduction2 = itemized_deductions * 0.80  # 17452\n\npease_reduction = min(reduction1, reduction2)  # 4358.28\nallowable_deductions = itemized_deductions - pease_reduction  # 17456.72\n\n# Taxable income\ntaxable_income = gross_income - allowable_deductions  # 377819.28\n\n# Tax calculation for unmarried individuals (section c)\n# (v) $79,772, plus 39.6% of the excess over $250,000 if taxable income > $250,000\nbase_tax = 79772\nexcess_over_250k = taxable_income - 250000  # 127819.28\ntax = base_tax + (excess_over_250k * 0.396)\n\nprint(f"Gross income: ${gross_income}")\nprint(f"Total itemized deductions: ${itemized_deductions}")\nprint(f"Pease reduction: ${pease_reduction}")\nprint(f"Allowable deductions: ${allowable_deductions}")\nprint(f"Taxable income: ${taxable_income}")\nprint(f"Tax: ${tax}")\nprint(f"Rounded tax: {round(tax)}")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
