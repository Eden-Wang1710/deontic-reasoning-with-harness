Sending keys: ['python3 << \'EOF\'\nimport datetime\n\n# 2017 dates and workers\ndates_and_workers = [\n    (datetime.date(2017, 1, 24), ["Bob", "Cameron", "Dan", "Emily", "Fred"]),\n    (datetime.date(2017, 2, 4), ["Bob", "Cameron", "Dan", "Emily", "Fred"]),\n    (datetime.date(2017, 3, 3), ["Bob", "Cameron", "Dan", "Emily", "Fred"]),\n    (datetime.date(2017, 3, 18), ["Cameron", "Dan", "Emily", "Fred", "George"]),\n    (datetime.date(2017, 4, 1), ["Bob", "Cameron", "Dan", "Fred", "George"]),\n    (datetime.date(2017, 5, 9), ["Cameron", "Dan", "Emily", "Fred", "George"]),\n    (datetime.date(2017, 10, 14), ["Bob", "Cameron", "Dan", "Emily", "George"]),\n    (datetime.date(2017, 10, 25), ["Bob", "Cameron", "Dan", "Emily", "Fred", "George"]),\n    (datetime.date(2017, 11, 8), ["Bob", "Cameron", "Emily", "Fred", "George"]),\n    (datetime.date(2017, 11, 22), ["Bob", "Cameron", "Dan", "Emily", "Fred"]),\n    (datetime.date(2017, 12, 1), ["Bob", "Cameron", "Dan", "Emily", "George"]),\n    (datetime.date(2017, 12, 2), ["Bob", "Cameron", "Dan", "Emily", "George"]),\n]\n\nprint("Date Analysis:")\nprint("="*60)\n\nweek_numbers = set()\ndays_with_5_plus = []\n\nfor date, workers in dates_and_workers:\n    weekday = date.weekday()  # Monday=0, Sunday=6\n    # ISO week number (Monday as first day of week)\n    iso_week = date.isocalendar()[1]\n    year = date.isocalendar()[0]\n    workers_count = len(workers)\n    \n    week_str = f"Jan 24, 2017 (Wk 4)"\n    if date.month == 2:\n        week_str = "Feb 4, 2017 (Wk 6)"\n    elif date.month == 3:\n        if date.day == 3:\n            week_str = "Mar 3, 2017 (Wk 9)"\n        else:\n            week_str = "Mar 18, 2017 (Wk 11)"\n    elif date.month == 4:\n        week_str = "Apr 1, 2017 (Wk 13)"\n    elif date.month == 5:\n        week_str = "May 9, 2017 (Wk 19)"\n    elif date.month == 10:\n        if date.day == 14:\n            week_str = "Oct 14, 2017 (Wk 42)"\n        else:\n            week_str = "Oct 25, 2017 (Wk 43)"\n    elif date.month == 11:\n        if date.day == 8:\n            week_str = "Nov 8, 2017 (Wk 45)"\n        else:\n            week_str = "Nov 22, 2017 (Wk 47)"\n    elif date.month == 12:\n        if date.day == 1:\n            week_str = "Dec 1, 2017 (Wk 48)"\n        else:\n            week_str = "Dec 2, 2017 (Wk 48)"\n    \n    print(f"{week_str} | {workers_count} workers | ISO Week {iso_week}")\n    \n    if workers_count >= 5:\n        days_with_5_plus.append(date)\n        week_numbers.add((year, iso_week))\n\nprint("\\n" + "="*60)\nprint(f"Days with 5+ workers: {len(days_with_5_plus)}")\nprint(f"Distinct calendar weeks (ISO): {len(week_numbers)}")\nprint(f"Weeks: {sorted(week_numbers)}")\n\n# Check if at least 10 days in different calendar weeks\nif len(days_with_5_plus) >= 10 and len(week_numbers) >= 10:\n    print("\\n§3306(a)(2)(B) SATISFIED: 10+ days in different weeks with 5+ workers")\nelse:\n    print(f"\\n§3306(a)(2)(B) NOT SATISFIED: Need 10 days, got {len(days_with_5_plus)} days in {len(week_numbers)} weeks")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
