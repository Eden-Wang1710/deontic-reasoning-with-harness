# OS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# Secrets / machine-local environment (API keys live in env vars, never in git)
.env
.env.*
!.env.example

# Claude Code machine-local settings (CLAUDE.md itself IS tracked)
.claude/settings.local.json

# DeonticBench: full "whole" splits are fetched from HuggingFace per machine
# (housing/whole.json is ~80 MB, over GitHub's comfortable file size).
#   python DeonticBench/scripts/download_hf_data.py --splits whole
DeonticBench/data/*/whole.json

# Run artifacts: tracked since 2026-10-27 (machine switch; the repo is the only sync
# channel). outputs/ and harbor-deonticbench/jobs/ are committed, including job logs.
bootstrap_results/
wandb/
*.log

# Model weights / checkpoints
*.ckpt
*.safetensors
*.pt
*.bin

# Re-include run artifacts and their logs (overrides *.log and the nested ignores)
!outputs/
!harbor-deonticbench/jobs/
!harbor-deonticbench/jobs/**
!harbor-deonticbench/jobs/**/*.log
!DeonticBench/outputs/
