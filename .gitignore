# OS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# Secrets / machine-local environment (API keys live in env vars, never in git)
.env
.env.*
!.env.example

# Claude Code machine-local settings (CLAUDE.md itself IS tracked)
.claude/settings.local.json

# DeonticBench: full "whole" splits are fetched from HuggingFace per machine
# (housing/whole.json is ~80 MB, over GitHub's comfortable file size).
#   python DeonticBench/scripts/download_hf_data.py --splits whole
DeonticBench/data/*/whole.json

# Run artifacts. outputs/ and DeonticBench/outputs/ (small per-trial summaries, ~10 MB) are
# tracked since 2026-10-27. harbor-deonticbench/jobs/ (full Harbor job dirs, ~470 MB and
# ~16k files) was tracked 2026-10-27..2026-10-31 for a machine switch and is ignored again
# since 2026-10-31; every job up to rv-smoke1 is still in git history (commit 0dc69015).
bootstrap_results/
wandb/
*.log
harbor-deonticbench/jobs/

# Model weights / checkpoints
*.ckpt
*.safetensors
*.pt
*.bin

# Re-include the small run summaries (overrides the nested DeonticBench ignore)
!outputs/
!DeonticBench/outputs/
